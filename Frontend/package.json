{
  "name": "desert-sound",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "NEXT_DIST_DIR=.next-build next build --webpack",
    "clean": "node -e \"const fs=require('fs'); ['.next', '.next-dev', '.next-build'].forEach((dir) => fs.rmSync(dir, { recursive: true, force: true }))\"",
    "db:init": "node --env-file=.env.local scripts/init-database.mjs",
    "dev": "NEXT_DIST_DIR=.next-dev next dev",
    "dev:clean": "npm run clean && npm run dev",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "start": "NEXT_DIST_DIR=.next-build next start",
    "vercel-build": "next build"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@radix-ui/react-slot": "^1.3.3",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.0.0",
    "lucide-react": "^1.30.0",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.26.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  }
}
